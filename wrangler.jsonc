{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "torn-lending-bank-public",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "torn-lending-bank-public",
      "database_id": "3e761715-8d42-4dc1-9fd5-039b16adf6ef",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
